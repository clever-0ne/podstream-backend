# ---- Server Configuration ----
# Port for the Express server (Fly.io and container hosts default to 8080)
PORT=8080

# Host binding:
# Use 0.0.0.0 for cloud deployment (Fly.io/Render) so network proxies can route traffic.
# Use 127.0.0.1 for local-only development.
HOST=0.0.0.0

# ---- Admin Dashboard Authentication ----
# Secret key sent as the 'X-Admin-Key' header by the admin dashboard.
# Set a strong key for production. If left empty, a random key is auto-generated in data/.admin-key.
ADMIN_KEY=your_secure_admin_key_here

# ---- Database Storage ----
# Path to SQLite database file inside the data directory
DB_FILE=data/honeypot.sqlite